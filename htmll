<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Kanujibay International Business</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
      text-align: center;
    }

    header {
      background: linear-gradient(90deg, #0b5d2a, #f57c00);
      color: white;
      padding: 40px 20px;
    }

    header img {
      width: 120px;
    }

    h1 {
      margin: 10px 0;
      font-size: 32px;
    }

    .section {
      padding: 60px 20px;
    }

    .services {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 30px;
    }

    .card {
      background: white;
      border-radius: 15px;
      padding: 20px;
      width: 250px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.1);
      transition: 0.3s;
    }

    .card:hover {
      transform: translateY(-5px);
    }

    .card img {
      width: 80px;
      margin-bottom: 15px;
    }

    .founder {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 40px;
    }

    .founder img {
      width: 250px;
      border-radius: 15px;
    }

    footer {
      background: #0b5d2a;
      color: white;
      padding: 30px;
    }
  </style>
</head>

<body>

<header>
  <img src="/logo.png" alt="logo">
  <h1>Kanujibay International Business</h1>
  <p>Commerce • Mobilité • Traduction</p>
</header>

<section class="section">
  <h2>Nos Services</h2>

  <div class="services">

    <div class="card">
      <img src="/cafe.jpg" alt="café">
      <h3>Coffee Business</h3>
      <p>Import - Export de café premium (Côte d'Ivoire)</p>
    </div>

    <div class="card">
      <img src="/avion.png" alt="avion">
      <h3>Student Mobility</h3>
      <p>Afrique • Europe • Asie</p>
    </div>

    <div class="card">
      <img src="/elephant.jpg" alt="éléphant">
      <h3>Translation</h3>
      <p>Français • Anglais • Russe • Ukrainien</p>
    </div>

  </div>
</section>

<section class="section" style="background:#fff;">
  <h2>Fondateur</h2>

  <div class="founder">
    <img src="/moi.jpg" alt="fondateur">

    <div>
      <h3>Ousseni SIDIBE</h3>
      <p>CEO - Kanujibay International Business</p>
      <p>📞 +33 6 37 33 30 66</p>
      <p>📧 kanujibayinternationalbusiness@gmail.com</p>
    </div>
  </div>
</section>

<footer>
  <p>© 2026 Kanujibay International Business</p>
</footer>

</body>
</html>
