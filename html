<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kanujibay International Business</title>

<style>

body {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background: #0d0d0d;
    color: white;
}

/* HEADER */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    background: black;
}

header img {
    width: 80px;
}

nav a {
    color: white;
    margin: 0 15px;
    text-decoration: none;
}

/* HERO IMAGE */
.hero {
    height: 100vh;
    background: url('https://images.unsplash.com/photo-1509042239860-f550ce710b93') center/cover;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}

.overlay {
    background: rgba(0,0,0,0.6);
    padding: 50px;
}

.hero h1 {
    font-size: 50px;
}

.btn {
    margin-top: 20px;
    padding: 15px 30px;
    background: #f7931e;
    color: white;
    text-decoration: none;
    border-radius: 5px;
}

/* SERVICES */
.services {
    padding: 80px 20px;
    text-align: center;
}

.cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
}

.card {
    background: #1a1a1a;
    margin: 15px;
    padding: 30px;
    width: 250px;
    border-radius: 10px;
    transition: 0.3s;
}

.card:hover {
    transform: scale(1.05);
    background: #0a7c3a;
}

/* SECTION IMAGE */
.image-section {
    height: 300px;
    background: url('https://images.unsplash.com/photo-1498804103079-a6351b050096') center/cover;
}

/* CONTACT */
.contact {
    padding: 60px;
    text-align: center;
    background: linear-gradient(90deg, #0a7c3a, #f7931e);
}

/* FOOTER */
footer {
    text-align: center;
    padding: 20px;
    background: black;
}

</style>
</head>

<body>

<header>
    <img src="logo.png">
    <nav>
        <a href="#">Accueil</a>
        <a href="#">Services</a>
        <a href="#">Contact</a>
    </nav>
</header>

<section class="hero">
    <div class="overlay">
        <h1>KANUJIBAY INTERNATIONAL BUSINESS</h1>
        <p>France 🇫🇷 – Côte d’Ivoire 🇨🇮</p>
        <a class="btn" href="https://wa.me/33637333066">Contact WhatsApp</a>
    </div>
</section>

<section class="services">
    <h2>Nos Services</h2>

    <div class="cards">
        <div class="card">
            <h3>☕ Coffee Export</h3>
            <p>Export de café premium de Côte d’Ivoire</p>
        </div>

        <div class="card">
            <h3>✈️ Business International</h3>
            <p>Connexion Afrique – Europe – Asie</p>
        </div>

        <div class="card">
            <h3>🌍 Traduction</h3>
            <p>Services multilingues professionnels</p>
        </div>
    </div>
</section>

<div class="image-section"></div>

<section class="contact">
    <h2>Contact</h2>
    <p>📞 +33 6 37 33 30 66</p>
    <p>📧 kanujibayinternationalbusiness@gmail.com</p>
</section>

<footer>
    © 2026 Kanujibay International Business
</footer>

</body>
</html>
